APP_NAME="Community Blood"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (must match config/database.php: DB_USERNAME + DB_DATABASE, not DB_USER/DB_NAME)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_blood
DB_USERNAME=root
DB_PASSWORD=


# Shared EmailJS account keys, plus one service/template pair per flow.
# Still used for: OTP verification, admin/donor password reset, and the
# contact form (see OtpController, AdminPasswordResetController,
# DonorPasswordResetController, ContactController).
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

EMAILJS_RESET_SERVICE_ID=
EMAILJS_RESET_TEMPLATE_ID=

# Contact form (see ContactController) — template needs "name", "email",
# and "message" params, and its "To Email" field set in the EmailJS
# dashboard to wherever you want messages delivered.
EMAILJS_CONTACT_SERVICE_ID=
EMAILJS_CONTACT_TEMPLATE_ID=


# Match/donation PDF-carrying emails (donor match, requester match,
# requester match-confirmed, donation completed) go through Resend's
# HTTPS API instead — see app/Services/ResendMailer.php, used by
# SendMatchNotifications, DonationMailService, MatchResponseController.
# Get a key at https://resend.com/api-keys — requires verifying at least
# one sending domain in the Resend dashboard first.
RESEND_API_KEY=

# From address used on Resend-sent emails only. The domain here MUST be a
# domain you've verified in Resend (Resend dashboard > Domains), or sends
# will fail. For quick testing before you've verified a domain, you can
# use onboarding@resend.dev instead (only delivers to your own account
# email until a domain is verified).
MAIL_FROM_ADDRESS="hello@communityblood.dpdns.org"
MAIL_FROM_NAME="Community Blood"


SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost


PORT=8000
