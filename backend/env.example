APP_NAME="Community Blood"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (must match config/database.php: DB_USERNAME + DB_DATABASE, not DB_USER/DB_NAME)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_blood
DB_USERNAME=root
DB_PASSWORD=


EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Used for the match-notification and donation-completion emails (these
# carry a PDF attachment, which EmailJS's REST API can't do, so they go
# through Laravel's own mailer instead). resend/resend-laravel is already
# installed — set MAIL_MAILER=resend and RESEND_API_KEY, or point
# MAIL_MAILER at smtp with your own SMTP credentials. Leaving MAIL_MAILER
# unset falls back to "log", which just writes emails to the log file
# instead of sending them — fine for local dev, not for production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@communityblood.org"
MAIL_FROM_NAME="Community Blood"
RESEND_API_KEY=


SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost


PORT=8000
